{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "db:setup": "bun --env-file=../../.env run scripts/db-setup.ts",
    "db:stop": "docker compose -f docker/dev.db.docker-compose.yml --env-file ../../.env stop db",
    "db:reset": "docker compose -f docker/dev.db.docker-compose.yml --env-file ../../.env down -v && bun run db:setup",
    "dev": "bun run db:setup && bun --env-file=../../.env --hot index.ts",
    "build": "bun build index.ts --outdir dist --target bun",
    "start": "bun --env-file=../../.env run dist/index.js"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/figlet": "^1.7.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "figlet": "^1.11.4"
  }
}
